{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs"],
  "categories": {
    "correctness": "error"
  },
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "rules": {
    "@stylistic/no-multiple-empty-lines": ["warn", { "max": 1 }]
  },
  "env": {
    "builtin": true
  }
}
